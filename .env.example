# URL gốc của website (KHÔNG có dấu "/" ở cuối)
# Môi trường dev: http://localhost:3000
# Môi trường production: https://connect.qtmmedia.vn
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mã xác minh Google Search Console (để trống nếu chưa có)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ==========================================
# CẤU HÌNH KẾT NỐI SUPABASE (PostgreSQL + Prisma)
# ==========================================
# 1. DATABASE_URL: Dùng Connection Pooler (Transaction mode, port 6543) cho ứng dụng Next.js runtime:
# Lấy tại Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI -> Mode: Transaction (port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Kết nối trực tiếp (Direct connection, port 5432) cho Prisma CLI (migrate / db push / seed):
# Lấy tại Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI -> Mode: Session / Direct (port 5432)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Chuỗi bí mật ký JSON Web Token (tối thiểu 32 ký tự)
JWT_SECRET=your-32-character-secret-key-change-me-in-production

# Tài khoản admin được tạo lần đầu bởi pnpm db:seed.
# Seed chạy lại giữ nguyên mật khẩu và phiên đăng nhập hiện có.
SEED_ADMIN_EMAIL=admin@qtmmedia.vn
SEED_ADMIN_PASSWORD=

# Upload avatar: preset unsigned đã cấu hình chỉ cho JPG/PNG/WebP, tối đa 2 MB.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
